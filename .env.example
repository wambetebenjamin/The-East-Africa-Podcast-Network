# =============================================================================
# The East Africa Podcast Network — environment variables
# Copy to .env.local and fill in. Everything is optional for local demo mode;
# each integration activates when its variables are present.
# =============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://eapn.africa

# --- Google reCAPTCHA (v3 invisible + v2 fallback) ---------------------------
# Site keys are public (NEXT_PUBLIC_); secret keys stay server-side only.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Optional v2 (checkbox) fallback when the v3 score is under 0.5:
NEXT_PUBLIC_RECAPTCHA_V2_SITE_KEY=
RECAPTCHA_SECRET_KEY_V2=

# --- NextAuth.js (listener accounts: Google OAuth + email magic link) -------
NEXTAUTH_URL=https://eapn.africa
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Nodemailer SMTP; also powers the magic-link emails) --------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="The East Africa Podcast Network <hello@eapn.africa>"
# Recipients
CONTACT_EMAIL=hello@eapn.africa
PRODUCER_EMAIL=producers@eapn.audio

# --- Vercel KV (shows, newsletter, subscribers, listening history) ----------
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Vercel Blob (media kit PDF + episode audio storage) --------------------
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_MEDIA_KIT_URL=

# --- WhatsApp ----------------------------------------------------------------
# Public number shown on the site (wa.me links):
NEXT_PUBLIC_WHATSAPP_NUMBER=254112272061
# Producer notification recipient:
PRODUCER_WHATSAPP=254112272061
# WhatsApp Cloud API (optional — when absent, wa.me links are used):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
